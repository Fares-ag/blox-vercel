############
# BLOX Qatar overlays — appended to supabase-docker/.env if keys are missing
############

# Public site(s) used in auth emails / redirects (comma-separated extras)
SITE_URL=https://customer.blox.com
ADDITIONAL_REDIRECT_URLS=https://admin.blox.com,https://customer.blox.com,https://staging-customer.blox.com,https://staging-admin.blox.com,bloxcustomer://

# Resend SMTP (auth emails) — replace with production credentials
SMTP_ADMIN_EMAIL=noreply@blox-it.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=REPLACE_WITH_RESEND_API_KEY
SMTP_SENDER_NAME=BLOX

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
DISABLE_SIGNUP=false
FUNCTIONS_VERIFY_JWT=false

# SkipCash (also loaded into Edge Functions via docker-compose.blox.yml)
SKIPCASH_CLIENT_ID=REPLACE_ME
SKIPCASH_KEY_ID=REPLACE_ME
SKIPCASH_SECRET_KEY=REPLACE_ME
SKIPCASH_WEBHOOK_KEY=REPLACE_ME
SKIPCASH_USE_SANDBOX=false
SKIPCASH_SANDBOX_URL=https://skipcashtest.azurewebsites.net
SKIPCASH_PRODUCTION_URL=https://api.skipcash.app

# Studio branding
STUDIO_DEFAULT_ORGANIZATION=BLOX
STUDIO_DEFAULT_PROJECT=blox-qatar
